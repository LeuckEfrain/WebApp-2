# --- WEBAPP2 PROJECT NAVIGATION START ---

@app.get(
    "/api/project/navigation",
    response_class=HTMLResponse,
)
def project_navigation(
    path: str = "",
    ref: str = "tests",
):
    """
    Dynamic HTML navigation interface for the GitHub repository.

    Directories become links to another navigation page.

    Files become links to the existing JSON contents endpoint.

    The structure is retrieved from GitHub at request time, so this
    endpoint does not maintain a hard-coded project tree.
    """

    import html
    import json
    import urllib.error
    import urllib.parse
    import urllib.request

    if ref not in {"tests", "main"}:
        return HTMLResponse(
            content="""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Unsupported repository ref</h1>
    <p>Allowed refs: main, tests</p>
</body>
</html>
""",
            status_code=400,
        )

    clean_path = path.strip("/")

    encoded_path = urllib.parse.quote(
        clean_path,
        safe="/",
    )

    github_url = (
        "https://api.github.com/repos/"
        "LeuckEfrain/WebApp-2/contents/"
        + encoded_path
        + "?ref="
        + urllib.parse.quote(ref, safe="")
    )

    request = urllib.request.Request(
        github_url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "WebApp-2-project-navigation",
        },
    )

    try:
        with urllib.request.urlopen(
            request,
            timeout=15,
        ) as response:
            payload = json.loads(
                response.read().decode("utf-8")
            )

    except urllib.error.HTTPError as error:

        try:
            body = error.read().decode("utf-8")
            github_error = json.loads(body)
        except Exception:
            github_error = {
                "message": str(error)
            }

        message = html.escape(
            str(
                github_error.get(
                    "message",
                    "GitHub request failed.",
                )
            )
        )

        return HTMLResponse(
            content=f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Project navigation error</h1>
    <p>{message}</p>
    <p>HTTP status: {error.code}</p>
</body>
</html>
""",
            status_code=502,
        )

    except Exception as error:

        message = html.escape(
            str(error)
        )

        return HTMLResponse(
            content=f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Project navigation error</h1>
    <p>{message}</p>
</body>
</html>
""",
            status_code=500,
        )

    # ------------------------------------------------------------------
    # Normalize GitHub's response.
    #
    # A directory returns a list.
    # A file returns an object.
    # ------------------------------------------------------------------

    if isinstance(payload, dict):

        # A file is not rendered as raw source here.
        # Instead, expose the existing contents API as a navigable link.

        file_path = payload.get(
            "path",
            clean_path,
        )

        encoded_file_path = urllib.parse.quote(
            file_path,
            safe="",
        )

        file_url = (
            "/api/project/contents"
            "?path="
            + encoded_file_path
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        escaped_path = html.escape(
            file_path
        )

        document = f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>

<h1>WebApp-2 Project Navigation</h1>

<p>
    File:
    <strong>{escaped_path}</strong>
</p>

<p>
    <a href="{html.escape(file_url)}">
        Inspect file contents
    </a>
</p>

</body>
</html>
"""

        return HTMLResponse(
            content=document
        )

    # ------------------------------------------------------------------
    # Directory listing
    # ------------------------------------------------------------------

    if not isinstance(payload, list):
        return HTMLResponse(
            content="""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Unexpected GitHub response</h1>
</body>
</html>
""",
            status_code=502,
        )

    escaped_path = html.escape(
        clean_path or "/"
    )

    links = []

    # Parent directory.

    if clean_path:

        parent_path = (
            clean_path.rsplit(
                "/",
                1,
            )[0]
        )

        parent_url = (
            "/api/project/navigation"
            "?path="
            + urllib.parse.quote(
                parent_path,
                safe="",
            )
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        links.append(
            f"""
<li>
    <a href="{html.escape(parent_url)}">
        ..
    </a>
</li>
"""
        )

    # GitHub returns directories and files separately.

    directories = []
    files = []

    for item in payload:

        item_type = item.get(
            "type",
            ""
        )

        item_path = item.get(
            "path",
            ""
        )

        item_name = item.get(
            "name",
            item_path,
        )

        if item_type == "dir":
            directories.append(
                (
                    item_name,
                    item_path,
                )
            )

        elif item_type == "file":
            files.append(
                (
                    item_name,
                    item_path,
                )
            )

    directories.sort(
        key=lambda value: value[0].lower()
    )

    files.sort(
        key=lambda value: value[0].lower()
    )

    # Directory links.

    for name, item_path in directories:

        directory_url = (
            "/api/project/navigation"
            "?path="
            + urllib.parse.quote(
                item_path,
                safe="",
            )
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        links.append(
            f"""
<li>
    <a href="{html.escape(directory_url)}">
        {html.escape(name)}/
    </a>
</li>
"""
        )

    # File links.

    for name, item_path in files:

        file_url = (
            "/api/project/contents"
            "?path="
            + urllib.parse.quote(
                item_path,
                safe="",
            )
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        links.append(
            f"""
<li>
    <a href="{html.escape(file_url)}">
        {html.escape(name)}
    </a>
</li>
"""
        )

    document = f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>

<h1>WebApp-2 Project Navigation</h1>

<p>
    Repository:
    <strong>LeuckEfrain/WebApp-2</strong>
</p>

<p>
    Ref:
    <strong>{html.escape(ref)}</strong>
</p>

<p>
    Current path:
    <strong>{escaped_path}</strong>
</p>

<p>
    This directory is generated from the live GitHub repository.
</p>

<ul>
    {''.join(links)}
</ul>

</body>
</html>
"""

    return HTMLResponse(
        content=document
    )

# --- WEBAPP2 PROJECT NAVIGATION END ---



# Local project root used by the read-only discovery layer.
ROOT = Path(__file__).resolve().parents[1]
# WEBAPP2_CROSS_ROOT_DISCOVERY
#
# The project and continuity hierarchy are intentionally separate roots.
# The continuity hierarchy is authoritative but remains read-only.

CONTINUITY_ROOT = (
    ROOT.parent
    / "continuity"
    / ROOT.name
)

DISCOVERY_MAX_FILE_BYTES = 250 * 1024

DISCOVERY_EXCLUDED_DIRECTORIES = {
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
}


def _cross_root_safe_relative_path(
    path: Path,
    root: Path,
) -> str:

    return path.relative_to(root).as_posix()


def _cross_root_is_excluded_path(
    path: Path,
    root: Path,
) -> bool:

    try:
        relative = path.relative_to(root)
    except ValueError:
        return True

    return any(
        part in DISCOVERY_EXCLUDED_DIRECTORIES
        for part in relative.parts
    )


def _cross_root_read_file(
    path: Path,
) -> dict:

    try:
        size = path.stat().st_size

    except OSError as exc:

        return {
            "size_bytes": None,
            "content_included": False,
            "content": None,
            "error": str(exc),
        }

    if size > DISCOVERY_MAX_FILE_BYTES:

        return {
            "size_bytes": size,
            "content_included": False,
            "content": None,
            "excluded_reason": (
                "file exceeds the per-file discovery "
                "safety limit"
            ),
        }

    try:

        content = path.read_text(
            encoding="utf-8",
            errors="replace",
        )

    except OSError as exc:

        return {
            "size_bytes": size,
            "content_included": False,
            "content": None,
            "error": str(exc),
        }

    return {
        "size_bytes": size,
        "content_included": True,
        "content": content,
    }


def _cross_root_inspect_root(
    root: Path,
    name: str,
    authoritative: bool,
) -> dict:

    if not root.exists():

        return {
            "name": name,
            "path": str(root),
            "exists": False,
            "authoritative": authoritative,
            "complete": False,
            "file_count": 0,
            "included_file_count": 0,
            "excluded_file_count": 0,
            "total_bytes": 0,
            "included_bytes": 0,
            "files": [],
            "errors": [
                {
                    "path": str(root),
                    "error": "root does not exist",
                }
            ],
        }

    if not root.is_dir():

        return {
            "name": name,
            "path": str(root),
            "exists": True,
            "authoritative": authoritative,
            "complete": False,
            "file_count": 0,
            "included_file_count": 0,
            "excluded_file_count": 0,
            "total_bytes": 0,
            "included_bytes": 0,
            "files": [],
            "errors": [
                {
                    "path": str(root),
                    "error": "root is not a directory",
                }
            ],
        }

    files = []
    errors = []

    total_bytes = 0
    included_bytes = 0
    included_file_count = 0
    excluded_file_count = 0

    try:

        paths = sorted(
            root.rglob("*"),
            key=lambda item: str(item).lower(),
        )

    except OSError as exc:

        return {
            "name": name,
            "path": str(root),
            "exists": True,
            "authoritative": authoritative,
            "complete": False,
            "file_count": 0,
            "included_file_count": 0,
            "excluded_file_count": 0,
            "total_bytes": 0,
            "included_bytes": 0,
            "files": [],
            "errors": [
                {
                    "path": str(root),
                    "error": str(exc),
                }
            ],
        }

    for path in paths:

        if not path.is_file():
            continue

        if _cross_root_is_excluded_path(
            path,
            root,
        ):
            continue

        relative_path = _cross_root_safe_relative_path(
            path,
            root,
        )

        result = _cross_root_read_file(
            path
        )

        size = result.get(
            "size_bytes"
        )

        if isinstance(size, int):

            total_bytes += size

        result["relative_path"] = (
            relative_path
        )

        if result.get(
            "content_included"
        ):

            included_file_count += 1

            if isinstance(size, int):

                included_bytes += size

        else:

            excluded_file_count += 1

        if result.get("error"):

            errors.append(
                {
                    "path": relative_path,
                    "error": result["error"],
                }
            )

        files.append(result)

    return {
        "name": name,
        "path": str(root),
        "exists": True,
        "authoritative": authoritative,
        "complete": (
            excluded_file_count == 0
            and len(errors) == 0
        ),
        "file_count": len(files),
        "included_file_count": included_file_count,
        "excluded_file_count": excluded_file_count,
        "total_bytes": total_bytes,
        "included_bytes": included_bytes,
        "files": files,
        "errors": errors,
    }


# WEBAPP2_DIRECT_COMPACT_INSPECTION
#
# Direct compact inspection.
#
# This implementation deliberately does NOT invoke the previous
# full-content inspection builder.
#
# It reads metadata from the project and continuity roots and returns
# a compact manifest.
#
# File contents remain available through:
# /api/agent/discovery/file
#
# READ-ONLY:
# No files are written.
# No project commands are executed.

def _cross_root_build_inspection():

    import hashlib
    from pathlib import Path

    project_root = Path(__file__).resolve().parent.parent

    continuity_root = (
        project_root.parent
        / "continuity"
        / "webapp_2"
    ).resolve()

    ignored_directories = {
        ".git",
        "__pycache__",
        "node_modules",
        ".venv",
        "venv",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".webapp2-refactor-backups",
    }

    ignored_suffixes = {
        ".pyc",
        ".pyo",
    }

    def file_metadata(
        path,
        root,
        root_name,
    ):

        relative_path = path.relative_to(
            root
        ).as_posix()

        try:
            size = path.stat().st_size

        except OSError:

            size = None

        digest = None

        try:

            hasher = hashlib.sha256()

            with path.open(
                "rb"
            ) as handle:

                while True:

                    chunk = handle.read(
                        1024 * 1024
                    )

                    if not chunk:
                        break

                    hasher.update(
                        chunk
                    )

            digest = hasher.hexdigest()

        except (
            OSError,
            PermissionError,
        ):

            digest = None

        return {
            "root": root_name,
            "path": relative_path,
            "name": path.name,
            "extension": path.suffix,
            "size": size,
            "sha256": digest,
            "readable": True,
            "content_endpoint": (
                "/api/agent/discovery/file"
            ),
        }

    def discover_root(
        root,
        root_name,
    ):

        files = []

        if not root.exists():

            return {
                "root": root_name,
                "path": str(root),
                "exists": False,
                "files": files,
                "file_count": 0,
            }

        for path in sorted(
            root.rglob("*"),
            key=lambda item: item.as_posix().lower(),
        ):

            if not path.is_file():
                continue

            relative_parts = (
                path.relative_to(root).parts
            )

            if any(
                part in ignored_directories
                for part in relative_parts
            ):
                continue

            if path.suffix.lower() in ignored_suffixes:
                continue

            files.append(
                file_metadata(
                    path,
                    root,
                    root_name,
                )
            )

        return {
            "root": root_name,
            "path": str(root),
            "exists": True,
            "file_count": len(files),
            "files": files,
        }

    project = discover_root(
        project_root,
        "project",
    )

    continuity = discover_root(
        continuity_root,
        "continuity",
    )

    return {
        "inspection_mode": "direct_compact_manifest",

        "read_only": True,

        "writes": False,

        "command_execution": False,

        "project_root": str(
            project_root
        ),

        "continuity_root": str(
            continuity_root
        ),

        "content_endpoint": (
            "/api/agent/discovery/file"
        ),

        "project": project,

        "continuity": continuity,

        "roots": {
            "project": {
                "path": str(project_root),
                "exists": project["exists"],
                "file_count": project["file_count"],
            },

            "continuity": {
                "path": str(continuity_root),
                "exists": continuity["exists"],
                "file_count": continuity["file_count"],
            },
        },
    }



# WEBAPP2_COMPACT_INSPECTION
#
# Produces the compact project/continuity inspection manifest.
#
# File contents remain available through the existing /file endpoint.
#
# This helper performs no writes and no command execution.

def _webapp2_compact_inspection():

    report = _cross_root_build_inspection()

    if not isinstance(report, dict):

        raise TypeError(
            "Cross-root inspection must return a dictionary."
        )

    def compact(value):

        if isinstance(value, list):

            return [
                compact(item)
                for item in value
            ]

        if not isinstance(value, dict):

            return value

        result = {}

        for key, item in value.items():

            normalized_key = str(key).lower()

            if normalized_key in {
                "content",
                "contents",
                "source",
                "text",
                "file_content",
                "file_contents",
                "source_text",
            }:

                continue

            result[key] = compact(item)

        return result

    compacted = compact(report)

    if not isinstance(
        compacted,
        dict,
    ):

        raise TypeError(
            "Compact inspection did not produce a dictionary."
        )

    compacted["_inspection_mode"] = (
        "compact_manifest"
    )

    compacted["_content_policy"] = {
        "file_contents_included": False,
        "content_retrieval_endpoint": (
            "/api/agent/discovery/file"
        ),
        "read_only": True,
        "command_execution": False,
        "writes": False,
    }

    return compacted



# --- WEBAPP2 LOCAL DISCOVERY START ---



# WEBAPP2 PROJECT INSPECTION REPORT

_INSPECTION_EXTENSIONS = {
    ".py",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".json",
    ".jsonc",
    ".css",
    ".scss",
    ".html",
    ".htm",
    ".md",
    ".txt",
    ".toml",
    ".yaml",
    ".yml",
    ".ini",
    ".cfg",
    ".conf",
    ".sh",
    ".ps1",
    ".bat",
    ".cmd",
    ".sql",
}

_INSPECTION_FILENAMES = {
    "Dockerfile",
    "Makefile",
    "Procfile",
    "requirements.txt",
    "pyproject.toml",
    "package.json",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "vite.config.js",
    "vite.config.jsx",
    "vite.config.ts",
    "vite.config.mjs",
    "vite.config.cjs",
}

_INSPECTION_EXCLUDED_DIRECTORIES = {
    ".git",
    ".venv",
    "venv",
    "env",
    "node_modules",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".cache",
    "dist",
    "build",
    "coverage",
    ".next",
    ".nuxt",
    ".turbo",
    ".idea",
    ".vscode",
    ".webapp2-refactor-backups",
}

_INSPECTION_MAX_FILE_BYTES = 250_000
_INSPECTION_MAX_TOTAL_BYTES = 2_500_000


def _inspection_relative(path):
    return path.resolve().relative_to(
        ROOT.resolve()
    ).as_posix()


def _inspection_excluded(path):
    try:
        relative = path.resolve().relative_to(
            ROOT.resolve()
        )
    except ValueError:
        return True

    return any(
        part in _INSPECTION_EXCLUDED_DIRECTORIES
        for part in relative.parts
    )


def _inspection_candidate(path):
    if _inspection_excluded(path):
        return False

    if not path.is_file():
        return False

    if path.name in _INSPECTION_FILENAMES:
        return True

    return path.suffix.lower() in _INSPECTION_EXTENSIONS


def _inspection_files():
    files = []

    for path in ROOT.rglob("*"):
        if _inspection_candidate(path):
            files.append(path)

    files.sort(
        key=lambda item: _inspection_relative(item).lower()
    )

    return files


def _inspection_file(path):
    relative = _inspection_relative(path)

    try:
        size = path.stat().st_size
    except OSError as exc:
        return {
            "path": relative,
            "included": False,
            "error": str(exc),
        }

    if size > _INSPECTION_MAX_FILE_BYTES:
        return {
            "path": relative,
            "size_bytes": size,
            "included": False,
            "reason": "per-file size limit exceeded",
        }

    try:
        content = path.read_text(
            encoding="utf-8",
            errors="replace",
        )
    except OSError as exc:
        return {
            "path": relative,
            "size_bytes": size,
            "included": False,
            "error": str(exc),
        }

    return {
        "path": relative,
        "size_bytes": size,
        "included": True,
        "content": content,
    }


def _inspection_directories():
    directories = []

    for path in ROOT.rglob("*"):
        if not path.is_dir():
            continue

        if _inspection_excluded(path):
            continue

        try:
            directories.append(
                _inspection_relative(path)
            )
        except ValueError:
            continue

    directories.sort(key=str.lower)

    return directories


def _inspection_git():
    git_dir = ROOT / ".git"

    if not git_dir.exists():
        return {
            "available": False,
        }

    result = {
        "available": True,
        "head": None,
        "branch": None,
    }

    head_file = git_dir / "HEAD"

    try:
        head = head_file.read_text(
            encoding="utf-8",
            errors="replace",
        ).strip()

        result["head"] = head

        prefix = "ref: refs/heads/"

        if head.startswith(prefix):
            result["branch"] = head[len(prefix):]

    except OSError as exc:
        result["error"] = str(exc)

    return result


def _project_inspection_report():
    files = _inspection_files()

    included = []
    omitted = []

    total_bytes = 0

    for path in files:

        try:
            size = path.stat().st_size
        except OSError:
            size = 0

        if (
            total_bytes + size
            > _INSPECTION_MAX_TOTAL_BYTES
        ):
            omitted.append({
                "path": _inspection_relative(path),
                "size_bytes": size,
                "included": False,
                "reason": "total report size limit exceeded",
            })
            continue

        item = _inspection_file(path)

        if item.get("included"):
            included.append(item)
            total_bytes += item.get(
                "size_bytes",
                0,
            )
        else:
            omitted.append(item)

    return {
        "name": "WebApp-2 Local Project Inspection",
        "version": "1",
        "mode": "READ-ONLY",
        "writes": False,
        "command_execution": False,
        "root": str(ROOT.resolve()),
        "structure": {
            "directories": _inspection_directories(),
            "files": [
                _inspection_relative(path)
                for path in files
            ],
        },
        "contents": {
            "files": included,
            "included_count": len(included),
            "omitted_count": len(omitted),
            "included_bytes": total_bytes,
            "omitted": omitted,
        },
        "git": _inspection_git(),
        "exclusions": sorted(
            _INSPECTION_EXCLUDED_DIRECTORIES
        ),
        "limits": {
            "max_file_bytes": _INSPECTION_MAX_FILE_BYTES,
            "max_total_bytes": _INSPECTION_MAX_TOTAL_BYTES,
        },
    }

@app.get(
    "/api/agent/discovery",
    response_class=HTMLResponse,
)
@app.get("/api/agent/discovery/continuity")
def agent_discovery_continuity():
    """
    Read-only access to the same authoritative continuity
    document used by the existing continuity parser.
    """

    continuity_path = (
        project_root.parent
        / "continuity"
        / "webapp_2"
    ).resolve()

    if not continuity_path.exists():
        return JSONResponse(
            status_code=404,
            content={
                "ok": False,
                "error": "Authoritative continuity document not found",
                "path": str(continuity_path),
            },
        )

    try:
        content = continuity_path.read_text(
            encoding="utf-8"
        )

    except Exception as exc:
        return JSONResponse(
            status_code=500,
            content={
                "ok": False,
                "error": "Unable to read authoritative continuity document",
                "detail": str(exc),
            },
        )

    return JSONResponse(
        content={
            "ok": True,
            "source": "authoritative_continuity_document",
            "path": str(continuity_path),
            "name": continuity_path.name,
            "size": len(
                content.encode("utf-8")
            ),
            "sha256": hashlib.sha256(
                content.encode("utf-8")
            ).hexdigest(),
            "content": content,
        }
    )

def agent_discovery(request: str = "index"):

    _webapp2_discovery_request = (
        request.strip().lower()
        if isinstance(request, str)
        else ""
    )

    if _webapp2_discovery_request in {
        "inspect",
        "inspection",
        "project",
        "full",
        "full-inspection",
    }:
        return JSONResponse(
            content=_webapp2_compact_inspection()
        )

    if request.strip().lower() in {
        "inspect",
        "inspection",
        "project_inspection",
    }:
        return JSONResponse(_project_inspection_report())


    """
    Read-only local project discovery entry point.
    """

    return """
<!doctype html>
<html>
<head>
    <title>WebApp-2 Local Agent Discovery</title>
</head>
<body>

<h1>WebApp-2 Local Agent Discovery</h1>

<p>
    Read-only local discovery interface.
</p>

<ul>
    <li>
        <a href="/api/agent/discovery/tree">
            Local Project Tree
        </a>
    </li>

    <li>
        <a href="/api/agent/discovery/file?path=backend%2Fmain.py">
            backend/main.py
        </a>
    </li>

    <li>
        <a href="/api/agent/discovery/search?q=protocol">
            Search Project
        </a>
    </li>

    <li>
        <a href="/api/agent/discovery/protocols">
            Active Protocols
        </a>
    </li>

    <li>
        <a href="/api/agent/discovery/git">
            Git State
        </a>
    </li>

</ul>

</body>
</html>
"""


@app.get(
    "/api/agent/discovery/tree",
)
def agent_discovery_tree(
    path: str = "",
):
    """
    Return a read-only listing of the local project.
    """

    import os

    requested = (
        ROOT
        / path.strip("/")
    ).resolve()

    try:
        requested.relative_to(ROOT.resolve())
    except ValueError:
        return {
            "error": "Path is outside the project root."
        }

    if not requested.exists():
        return {
            "error": "Path does not exist.",
            "path": path,
        }

    if not requested.is_dir():
        return {
            "error": "Path is not a directory.",
            "path": path,
        }

    entries = []

    try:
        children = sorted(
            requested.iterdir(),
            key=lambda item: (
                not item.is_dir(),
                item.name.lower(),
            ),
        )

        for child in children:

            relative = child.relative_to(ROOT)

            entries.append(
                {
                    "name": child.name,
                    "path": relative.as_posix(),
                    "type": (
                        "directory"
                        if child.is_dir()
                        else "file"
                    ),
                }
            )

    except OSError as error:
        return {
            "error": "Unable to read directory.",
            "detail": str(error),
            "path": path,
        }

    return {
        "type": "directory",
        "path": (
            requested.relative_to(ROOT).as_posix()
            if requested != ROOT
            else ""
        ),
        "entries": entries,
    }


@app.get(
    "/api/agent/discovery/file",
)
def agent_discovery_file(
    path: str,
    start_line: int = 1,
    end_line: int | None = None,
):
    """
    Return read-only contents and metadata for a local file.
    """

    requested = (
        ROOT
        / path.strip("/")
    ).resolve()

    try:
        requested.relative_to(ROOT.resolve())
    except ValueError:
        return {
            "error": "Path is outside the project root."
        }

    if not requested.exists():
        return {
            "error": "File does not exist.",
            "path": path,
        }

    if not requested.is_file():
        return {
            "error": "Path is not a file.",
            "path": path,
        }

    if start_line < 1:
        return {
            "error": "start_line must be at least 1."
        }

    try:
        text = requested.read_text(
            encoding="utf-8",
            errors="replace",
        )
    except OSError as error:
        return {
            "error": "Unable to read file.",
            "detail": str(error),
            "path": path,
        }

    lines = text.splitlines()

    total_lines = len(lines)

    if end_line is None:
        selected_end = total_lines
    else:
        selected_end = min(
            end_line,
            total_lines,
        )

    if selected_end < start_line:
        selected_lines = []
    else:
        selected_lines = lines[
            start_line - 1:selected_end
        ]

    return {
        "type": "file",
        "path": requested.relative_to(ROOT).as_posix(),
        "size": requested.stat().st_size,
        "total_lines": total_lines,
        "start_line": start_line,
        "end_line": selected_end,
        "content": "\n".join(selected_lines),
    }


@app.get(
    "/api/agent/discovery/search",
)
def agent_discovery_search(
    q: str,
    path: str = "",
):
    """
    Read-only text search through local project files.
    """

    import os

    query = q.strip()

    if not query:
        return {
            "error": "Search query cannot be empty."
        }

    search_root = (
        ROOT
        / path.strip("/")
    ).resolve()

    try:
        search_root.relative_to(ROOT.resolve())
    except ValueError:
        return {
            "error": "Search path is outside the project root."
        }

    if not search_root.exists():
        return {
            "error": "Search path does not exist.",
            "path": path,
        }

    if search_root.is_file():
        files = [search_root]
    else:
        files = []

        for current_root, directories, filenames in os.walk(
            search_root
        ):

            current = Path(current_root)

            directories[:] = [
                directory
                for directory in directories
                if directory not in {
                    ".git",
                    "node_modules",
                    "__pycache__",
                    ".venv",
                    "venv",
                    ".webapp2-refactor-backups",
                }
            ]

            for filename in filenames:
                files.append(
                    current / filename
                )

    results = []

    query_lower = query.lower()

    for file_path in files:

        try:
            text = file_path.read_text(
                encoding="utf-8",
                errors="replace",
            )
        except (
            OSError,
            UnicodeError,
        ):
            continue

        lines = text.splitlines()

        for index, line in enumerate(
            lines,
            start=1,
        ):

            if query_lower in line.lower():

                results.append(
                    {
                        "path": file_path.relative_to(
                            ROOT
                        ).as_posix(),
                        "line": index,
                        "text": line,
                    }
                )

                if len(results) >= 200:
                    return {
                        "query": query,
                        "path": path,
                        "truncated": True,
                        "results": results,
                    }

    return {
        "query": query,
        "path": path,
        "truncated": False,
        "results": results,
    }


@app.get(
    "/api/agent/discovery/protocols",
    response_class=HTMLResponse,
)
def agent_discovery_protocols():
    """
    Read-only protocol discovery.

    Searches known protocol locations and exposes discovered files
    as actual HTML navigation links.
    """

    protocol_roots = [
        ROOT / "protocols",
        ROOT / "tools" / "protocols",
        ROOT / ".protocols",
    ]

    discovered = []

    for protocol_root in protocol_roots:

        if not protocol_root.exists():
            continue

        if not protocol_root.is_dir():
            continue

        for file_path in protocol_root.rglob("*"):

            if not file_path.is_file():
                continue

            if file_path.name.startswith("."):
                continue

            relative = file_path.relative_to(ROOT)

            url = (
                "/api/agent/discovery/file"
                "?path="
                + __import__("urllib.parse").parse.quote(
                    relative.as_posix(),
                    safe="",
                )
            )

            discovered.append(
                (
                    relative.as_posix(),
                    url,
                )
            )

    discovered.sort(
        key=lambda item: item[0].lower()
    )

    if not discovered:

        body = """
<p>No protocol files were discovered in the known
protocol locations.</p>
"""

    else:

        links = []

        for path, url in discovered:

            links.append(
                f"""
<li>
    <a href="{url}">
        {path}
    </a>
</li>
"""
            )

        body = (
            "<ul>"
            + "".join(links)
            + "</ul>"
        )

    return HTMLResponse(
        content=f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Active Protocols</title>
</head>
<body>

<h1>WebApp-2 Active Protocols</h1>

<p>
    Read-only protocol discovery.
</p>

{body}

</body>
</html>
"""
    )


@app.get(
    "/api/agent/discovery/git",
)
def agent_discovery_git():
    """
    Read-only Git metadata.

    This does not execute arbitrary commands. It only reads Git's
    existing metadata through the repository's .git directory.
    """

    import configparser

    git_root = ROOT / ".git"

    if not git_root.exists():
        return {
            "error": "Git metadata directory was not found."
        }

    head_file = git_root / "HEAD"

    if not head_file.exists():
        return {
            "error": "Git HEAD file was not found."
        }

    try:
        head = head_file.read_text(
            encoding="utf-8",
            errors="replace",
        ).strip()
    except OSError as error:
        return {
            "error": "Unable to read Git HEAD.",
            "detail": str(error),
        }

    branch = None

    if head.startswith("ref:"):
        branch = head[
            len("ref:"):].strip()
        branch = branch.removeprefix(
            "refs/heads/"
        )

    return {
        "repository_root": str(ROOT),
        "head": head,
        "branch": branch,
        "read_only": True,
    }


