module = PackageManagerModule()

@app.get("/api/health")
def health(): return {"status":"ok"}
@app.get("/api/package-managers")
def package_managers(): return module.managers()
@app.get("/api/software")
def software(): return module.installed_software()
@app.get("/api/download/destination")
def download_destination():
    destination = module.get_download_directory()

    return {
        "destination": destination
    }
@app.get("/api/package-managers/{manager}/search")
def search(manager: str, q: str = ""): return module.search(manager, q)
@app.post("/api/package-managers/download")
def download_packages(request: DownloadRequest):
    return module.download_packages(request.packages)


