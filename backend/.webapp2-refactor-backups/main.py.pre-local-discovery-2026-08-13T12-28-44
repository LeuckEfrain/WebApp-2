# --- WEBAPP2 PROJECT NAVIGATION START ---

@app.get(
    "/api/project/navigation",
    response_class=HTMLResponse,
)
def project_navigation(
    path: str = "",
    ref: str = "tests",
):
    """
    Dynamic HTML navigation interface for the GitHub repository.

    Directories become links to another navigation page.

    Files become links to the existing JSON contents endpoint.

    The structure is retrieved from GitHub at request time, so this
    endpoint does not maintain a hard-coded project tree.
    """

    import html
    import json
    import urllib.error
    import urllib.parse
    import urllib.request

    if ref not in {"tests", "main"}:
        return HTMLResponse(
            content="""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Unsupported repository ref</h1>
    <p>Allowed refs: main, tests</p>
</body>
</html>
""",
            status_code=400,
        )

    clean_path = path.strip("/")

    encoded_path = urllib.parse.quote(
        clean_path,
        safe="/",
    )

    github_url = (
        "https://api.github.com/repos/"
        "LeuckEfrain/WebApp-2/contents/"
        + encoded_path
        + "?ref="
        + urllib.parse.quote(ref, safe="")
    )

    request = urllib.request.Request(
        github_url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "WebApp-2-project-navigation",
        },
    )

    try:
        with urllib.request.urlopen(
            request,
            timeout=15,
        ) as response:
            payload = json.loads(
                response.read().decode("utf-8")
            )

    except urllib.error.HTTPError as error:

        try:
            body = error.read().decode("utf-8")
            github_error = json.loads(body)
        except Exception:
            github_error = {
                "message": str(error)
            }

        message = html.escape(
            str(
                github_error.get(
                    "message",
                    "GitHub request failed.",
                )
            )
        )

        return HTMLResponse(
            content=f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Project navigation error</h1>
    <p>{message}</p>
    <p>HTTP status: {error.code}</p>
</body>
</html>
""",
            status_code=502,
        )

    except Exception as error:

        message = html.escape(
            str(error)
        )

        return HTMLResponse(
            content=f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Project navigation error</h1>
    <p>{message}</p>
</body>
</html>
""",
            status_code=500,
        )

    # ------------------------------------------------------------------
    # Normalize GitHub's response.
    #
    # A directory returns a list.
    # A file returns an object.
    # ------------------------------------------------------------------

    if isinstance(payload, dict):

        # A file is not rendered as raw source here.
        # Instead, expose the existing contents API as a navigable link.

        file_path = payload.get(
            "path",
            clean_path,
        )

        encoded_file_path = urllib.parse.quote(
            file_path,
            safe="",
        )

        file_url = (
            "/api/project/contents"
            "?path="
            + encoded_file_path
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        escaped_path = html.escape(
            file_path
        )

        document = f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>

<h1>WebApp-2 Project Navigation</h1>

<p>
    File:
    <strong>{escaped_path}</strong>
</p>

<p>
    <a href="{html.escape(file_url)}">
        Inspect file contents
    </a>
</p>

</body>
</html>
"""

        return HTMLResponse(
            content=document
        )

    # ------------------------------------------------------------------
    # Directory listing
    # ------------------------------------------------------------------

    if not isinstance(payload, list):
        return HTMLResponse(
            content="""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>
    <h1>Unexpected GitHub response</h1>
</body>
</html>
""",
            status_code=502,
        )

    escaped_path = html.escape(
        clean_path or "/"
    )

    links = []

    # Parent directory.

    if clean_path:

        parent_path = (
            clean_path.rsplit(
                "/",
                1,
            )[0]
        )

        parent_url = (
            "/api/project/navigation"
            "?path="
            + urllib.parse.quote(
                parent_path,
                safe="",
            )
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        links.append(
            f"""
<li>
    <a href="{html.escape(parent_url)}">
        ..
    </a>
</li>
"""
        )

    # GitHub returns directories and files separately.

    directories = []
    files = []

    for item in payload:

        item_type = item.get(
            "type",
            ""
        )

        item_path = item.get(
            "path",
            ""
        )

        item_name = item.get(
            "name",
            item_path,
        )

        if item_type == "dir":
            directories.append(
                (
                    item_name,
                    item_path,
                )
            )

        elif item_type == "file":
            files.append(
                (
                    item_name,
                    item_path,
                )
            )

    directories.sort(
        key=lambda value: value[0].lower()
    )

    files.sort(
        key=lambda value: value[0].lower()
    )

    # Directory links.

    for name, item_path in directories:

        directory_url = (
            "/api/project/navigation"
            "?path="
            + urllib.parse.quote(
                item_path,
                safe="",
            )
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        links.append(
            f"""
<li>
    <a href="{html.escape(directory_url)}">
        {html.escape(name)}/
    </a>
</li>
"""
        )

    # File links.

    for name, item_path in files:

        file_url = (
            "/api/project/contents"
            "?path="
            + urllib.parse.quote(
                item_path,
                safe="",
            )
            + "&ref="
            + urllib.parse.quote(
                ref,
                safe="",
            )
        )

        links.append(
            f"""
<li>
    <a href="{html.escape(file_url)}">
        {html.escape(name)}
    </a>
</li>
"""
        )

    document = f"""
<!doctype html>
<html>
<head>
    <title>WebApp-2 Project Navigation</title>
</head>
<body>

<h1>WebApp-2 Project Navigation</h1>

<p>
    Repository:
    <strong>LeuckEfrain/WebApp-2</strong>
</p>

<p>
    Ref:
    <strong>{html.escape(ref)}</strong>
</p>

<p>
    Current path:
    <strong>{escaped_path}</strong>
</p>

<p>
    This directory is generated from the live GitHub repository.
</p>

<ul>
    {''.join(links)}
</ul>

</body>
</html>
"""

    return HTMLResponse(
        content=document
    )

