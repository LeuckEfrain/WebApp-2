import {
    useEffect,
    useMemo,
    useState
} from 'react';

import {
    loadContinuitySections
} from './continuityData';


function Section({
    section,
    open,
    onToggle,
    activeGoal,
    onGoalSelect
}) {
    return (
        <section className="continuity-section">
            <button
                type="button"
                className="continuity-section-header"
                onClick={onToggle}
                aria-expanded={open}
            >
                <span className="continuity-section-title">
                    {section.title}
                </span>

                <span className="continuity-section-toggle">
                    {open ? '−' : '+'}
                </span>
            </button>

            {open && (
                <div className="continuity-section-body indefinite-list">

                    {section.description && (
                        <p className="continuity-description">
                            {section.description}
                        </p>
                    )}

                    {section.content?.map((item, index) => (
                        <div
                            className="continuity-detail"
                            key={`${section.id}-content-${index}`}
                        >
                            {item}
                        </div>
                    ))}

                    {section.items?.map((item, index) => (
                        <article
                            className="continuity-item"
                            key={`${section.id}-item-${index}`}
                        >
                            <strong>
                                {item.title}
                            </strong>

                            <p>
                                {item.body}
                            </p>
                        </article>
                    ))}

                    {section.goals?.map(goal => {
                        const selected =
                            activeGoal === goal.id;

                        return (
                            <article
                                className={
                                    'continuity-goal' +
                                    (selected
                                        ? ' active'
                                        : '')
                                }
                                key={goal.id}
                            >
                                <div className="continuity-goal-header">
                                    <div>
                                        <strong>
                                            {goal.title}
                                        </strong>

                                        <span className="continuity-status">
                                            {goal.status}
                                        </span>
                                    </div>

                                    <div className="continuity-goal-actions">
                                        <button
                                            type="button"
                                            className={
                                                selected
                                                    ? 'secondary'
                                                    : 'primary'
                                            }
                                            onClick={() =>
                                                onGoalSelect(
                                                    selected
                                                        ? null
                                                        : goal.id
                                                )
                                            }
                                        >
                                            {selected
                                                ? 'Active Goal'
                                                : 'Set Active'}
                                        </button>
                                    </div>
                                </div>

                                {goal.body && (
                                    <p>
                                        {goal.body}
                                    </p>
                                )}
                            </article>
                        );
                    })}

                    {section.phases?.map((phase, index) => (
                        <article
                            className="continuity-phase-card"
                            key={`${section.id}-phase-${index}`}
                        >
                            <div className="continuity-phase-card-head">
                                <strong>
                                    {phase.title}
                                </strong>

                                <span className="continuity-status">
                                    {phase.status}
                                </span>
                            </div>

                            <p>
                                {phase.body}
                            </p>
                        </article>
                    ))}

                    {!section.content?.length &&
                        !section.items?.length &&
                        !section.goals?.length &&
                        !section.phases?.length && (
                            <div className="continuity-detail">
                                No content is currently available
                                for this section.
                            </div>
                        )}
                </div>
            )}
        </section>
    );
}


function ContinuityViewer() {
    const [continuitySections, setContinuitySections] =
        useState([]);

    const [continuityLoading, setContinuityLoading] =
        useState(true);

    const [continuityError, setContinuityError] =
        useState(null);

    const [openSections, setOpenSections] =
        useState(
            () => new Set(['goals'])
        );

    const [activeGoal, setActiveGoal] =
        useState(
            () =>
                localStorage.getItem(
                    'webapp2-continuity-active-goal'
                ) || null
        );

    useEffect(() => {
        let cancelled = false;

        async function load() {
            try {
                setContinuityLoading(true);
                setContinuityError(null);

                const result =
                    await loadContinuitySections();

                if (!cancelled) {
                    setContinuitySections(
                        result.sections
                    );
                }
            } catch (error) {
                if (!cancelled) {
                    setContinuityError(
                        error instanceof Error
                            ? error.message
                            : 'Unable to load continuity data.'
                    );
                }
            } finally {
                if (!cancelled) {
                    setContinuityLoading(false);
                }
            }
        }

        load();

        return () => {
            cancelled = true;
        };
    }, []);

    const visibleCount = useMemo(
        () => openSections.size,
        [openSections]
    );

    const toggleSection = id => {
        setOpenSections(current => {
            const next = new Set(current);

            if (next.has(id)) {
                next.delete(id);
            } else {
                next.add(id);
            }

            return next;
        });
    };

    const selectGoal = id => {
        setActiveGoal(id);

        if (id) {
            localStorage.setItem(
                'webapp2-continuity-active-goal',
                id
            );
        } else {
            localStorage.removeItem(
                'webapp2-continuity-active-goal'
            );
        }
    };

    const openAll = () => {
        setOpenSections(
            new Set(
                continuitySections.map(
                    section => section.id
                )
            )
        );
    };

    const closeAll = () => {
        setOpenSections(new Set());
    };

    return (
        <div className="continuity-viewer">

            <div className="continuity-toolbar">
                <div>
                    <div className="eyebrow">
                        INSTANCE MODULE
                    </div>

                    <h2>
                        Continuity
                    </h2>

                    <p>
                        Navigate the active WebApp-2
                        project state without reading
                        the raw document.
                    </p>
                </div>

                <div className="continuity-toolbar-actions">
                    <button
                        type="button"
                        className="secondary"
                        onClick={openAll}
                        disabled={continuityLoading}
                    >
                        Open All
                    </button>

                    <button
                        type="button"
                        className="secondary"
                        onClick={closeAll}
                        disabled={continuityLoading}
                    >
                        Close All
                    </button>
                </div>
            </div>

            <div className="continuity-summary">
                <div>
                    <span>
                        OPEN SECTIONS
                    </span>

                    <strong>
                        {visibleCount}
                    </strong>
                </div>

                <div>
                    <span>
                        ACTIVE GOAL
                    </span>

                    <strong>
                        {activeGoal
                            ? 'Selected'
                            : 'None'}
                    </strong>
                </div>

                <div>
                    <span>
                        MODULE TYPE
                    </span>

                    <strong>
                        INSTANCE
                    </strong>
                </div>
            </div>

            {continuityLoading && (
                <div className="continuity-detail">
                    Loading authoritative continuity data…
                </div>
            )}

            {continuityError && (
                <div className="continuity-detail">
                    Unable to load continuity data:
                    {' '}
                    {continuityError}
                </div>
            )}

            {!continuityLoading &&
                !continuityError && (
                    <div className="continuity-sections">
                        {continuitySections.map(
                            section => (
                                <Section
                                    key={section.id}
                                    section={section}
                                    open={openSections.has(
                                        section.id
                                    )}
                                    onToggle={() =>
                                        toggleSection(
                                            section.id
                                        )
                                    }
                                    activeGoal={
                                        activeGoal
                                    }
                                    onGoalSelect={
                                        selectGoal
                                    }
                                />
                            )
                        )}
                    </div>
                )}
        </div>
    );
}


export default ContinuityViewer;
