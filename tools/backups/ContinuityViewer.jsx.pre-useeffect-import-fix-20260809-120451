import { useMemo, useState } from 'react';

const CONTINUITY_DOCUMENT_URL =
    '/continuity/webapp2_continuity.txt';


function normalizeContinuityHeading(value) {
    return value
        .replace(/^[#\s>*\-•]+/, '')
        .replace(/[:：]\s*$/, '')
        .trim()
        .toLowerCase()
        .replace(/\s+/g, ' ');
}


function cleanContinuityLine(value) {
    return value
        .replace(/\r/g, '')
        .trim();
}


function continuitySectionDefinition() {
    return [
        {
            id: 'vision',
            title: 'Project Vision',
            aliases: [
                'project vision',
                'vision'
            ]
        },
        {
            id: 'protocols',
            title: 'Protocols',
            aliases: [
                'protocols',
                'protocol',
                'rules',
                'continuity protocols',
                'development protocols'
            ]
        },
        {
            id: 'goals',
            title: 'Goals',
            aliases: [
                'goals',
                'project goals',
                'objectives'
            ]
        },
        {
            id: 'architecture',
            title: 'Architecture',
            aliases: [
                'architecture',
                'architectural state',
                'system architecture'
            ]
        },
        {
            id: 'phases',
            title: 'Development Phases',
            aliases: [
                'development phases',
                'phases',
                'development plan',
                'planned phases'
            ]
        }
    ];
}


function parseContinuityDocument(text) {
    const definitions =
        continuitySectionDefinition();

    const sections =
        definitions.map(definition => ({
            id: definition.id,
            title: definition.title,
            description: '',
            content: [],
            items: [],
            goals: [],
            phases: []
        }));

    const sectionMap =
        new Map(
            sections.map(section => [
                section.id,
                section
            ])
        );

    const lines = text
        .replace(/\r\n/g, '\n')
        .split('\n');

    let currentSection = null;
    let currentGoal = null;

    const findSection = line => {
        const normalized =
            normalizeContinuityHeading(line);

        return definitions.find(
            definition =>
                definition.aliases.includes(
                    normalized
                )
        );
    };

    const looksLikeSectionHeading = line => {
        const normalized =
            normalizeContinuityHeading(line);

        return definitions.some(
            definition =>
                definition.aliases.includes(
                    normalized
                )
        );
    };

    for (
        let index = 0;
        index < lines.length;
        index++
    ) {
        const line =
            cleanContinuityLine(lines[index]);

        if (!line) {
            continue;
        }


        // ----------------------------------------------------
        // Section heading
        // ----------------------------------------------------

        const matchedSection =
            findSection(line);

        if (matchedSection) {
            currentSection =
                sectionMap.get(
                    matchedSection.id
                );

            currentGoal = null;

            continue;
        }


        if (!currentSection) {
            continue;
        }


        // ----------------------------------------------------
        // Document metadata
        // ----------------------------------------------------

        if (
            /^current revision\s*:/i.test(line) ||
            /^revision\s*:/i.test(line) ||
            /^last updated\s*:/i.test(line) ||
            /^project url\s*:/i.test(line)
        ) {
            continue;
        }


        // ----------------------------------------------------
        // Goals
        //
        // Supports forms such as:
        //
        // Goal: Home Launcher
        // - Goal: Home Launcher
        // ## Goal: Home Launcher
        // ----------------------------------------------------

        if (
            currentSection.id === 'goals'
        ) {
            const goalMatch =
                line.match(
                    /^(?:[-*•]\s*)?(?:goal|objective)\s*[:\-—]\s*(.+)$/i
                );

            if (goalMatch) {
                const title =
                    goalMatch[1].trim();

                currentGoal = {
                    id: title
                        .toLowerCase()
                        .replace(
                            /[^a-z0-9]+/g,
                            '-'
                        )
                        .replace(
                            /^-+|-+$/g,
                            ''
                        ),
                    title,
                    status: 'Planned',
                    phases: []
                };

                currentSection.goals.push(
                    currentGoal
                );

                continue;
            }


            if (
                currentGoal &&
                /^status\s*:/i.test(line)
            ) {
                currentGoal.status =
                    line
                        .replace(
                            /^status\s*:/i,
                            ''
                        )
                        .trim();

                continue;
            }


            if (
                currentGoal
            ) {
                const goalPhaseMatch =
                    line.match(
                        /^(?:[-*•]\s*)?phase\s*(\d+)?\s*[\-—:]\s*(.+)$/i
                    );

                if (goalPhaseMatch) {
                    currentGoal.phases.push(
                        goalPhaseMatch[2].trim()
                    );

                    continue;
                }
            }
        }


        // ----------------------------------------------------
        // Development phases
        // ----------------------------------------------------

        if (
            currentSection.id === 'phases'
        ) {
            const phaseMatch =
                line.match(
                    /^(?:[-*•]\s*)?(phase\s*\d+.*?)$/i
                );

            if (phaseMatch) {
                const title =
                    phaseMatch[1].trim();

                let status = 'Planned';
                let body = '';

                const nextLine =
                    cleanContinuityLine(
                        lines[index + 1] || ''
                    );

                if (
                    /^status\s*:/i.test(
                        nextLine
                    )
                ) {
                    status =
                        nextLine
                            .replace(
                                /^status\s*:/i,
                                ''
                            )
                            .trim();

                    index++;
                }

                const possibleBody =
                    cleanContinuityLine(
                        lines[index + 1] || ''
                    );

                if (
                    possibleBody &&
                    !looksLikeSectionHeading(
                        possibleBody
                    ) &&
                    !/^phase\s+\d+/i.test(
                        possibleBody
                    )
                ) {
                    body = possibleBody;
                    index++;
                }

                currentSection.phases.push({
                    title,
                    status,
                    body
                });

                continue;
            }
        }


        // ----------------------------------------------------
        // Protocol / architecture labeled items
        //
        // Example:
        //
        // Backup: Automated source modifications...
        // ----------------------------------------------------

        if (
            currentSection.id ===
                'protocols' ||
            currentSection.id ===
                'architecture'
        ) {
            const itemMatch =
                line.match(
                    /^(?:[-*•]\s*)?([^:]{2,100}):\s*(.+)$/
                );

            if (itemMatch) {
                currentSection.items.push({
                    title:
                        itemMatch[1].trim(),
                    body:
                        itemMatch[2].trim()
                });

                continue;
            }
        }


        // ----------------------------------------------------
        // Bullet content
        // ----------------------------------------------------

        if (
            /^[-*•]\s+/.test(line)
        ) {
            const value =
                line
                    .replace(
                        /^[-*•]\s+/,
                        ''
                    )
                    .trim();

            if (value) {
                currentSection.content.push(
                    value
                );
            }

            continue;
        }


        // ----------------------------------------------------
        // Ordinary prose
        // ----------------------------------------------------

        if (
            !currentSection.description
        ) {
            currentSection.description =
                line;
        } else {
            currentSection.content.push(
                line
            );
        }
    }


    return sections.filter(
        section =>
            section.description ||
            section.content.length ||
            section.items.length ||
            section.goals.length ||
            section.phases.length
    );
}


function getContinuityRevision(content) {
    const match = content.match(
        /Current Revision:\s*\n\s*(\d+)/
    );

    return match
        ? match[1]
        : null;
};


function Section({
    section,
    open,
    onToggle,
    activeGoal,
    onGoalSelect,
    openGoalPhases,
    onGoalPhaseToggle,
    getPhaseState,
    onPhaseStateChange
}) {
    return (
        <section className="continuity-section">
            <button
                type="button"
                className="continuity-section-header"
                onClick={onToggle}
                aria-expanded={open}
            >
                <span className="continuity-section-title">
                    {section.title}
                </span>

                <span className="continuity-section-toggle">
                    {open ? '−' : '+'}
                </span>
            </button>

            {open && (
                <div className="continuity-section-body indefinite-list">

                    {section.description && (
                        <p className="continuity-description">
                            {section.description}
                        </p>
                    )}

                    {section.content?.map(item => (
                        <div
                            className="continuity-detail"
                            key={item}
                        >
                            {item}
                        </div>
                    ))}

                    {section.items?.map(item => (
                        <article
                            className="continuity-item"
                            key={item.title}
                        >
                            <strong>{item.title}</strong>
                            <p>{item.body}</p>
                        </article>
                    ))}

                    {section.goals?.map(goal => {
                        const selected =
                            activeGoal === goal.id;

                        const phasesOpen =
                            openGoalPhases.has(goal.id);

                        const allPhasesComplete =
                            goal.phases.length > 0 &&
                            goal.phases.every(
                                (_, index) =>
                                    getPhaseState(
                                        goal.id,
                                        index
                                    ).complete
                            );

                        const goalStatus =
                            allPhasesComplete
                                ? 'Complete'
                                : goal.status;

                        return (
                            <article
                                className={
                                    'continuity-goal' +
                                    (selected
                                        ? ' active'
                                        : '') +
                                    (allPhasesComplete
                                        ? ' complete'
                                        : '')
                                }
                                key={goal.id}
                            >
                                <div className="continuity-goal-header">
                                    <div>
                                        <strong>{goal.title}</strong>

                                        <span className="continuity-status">
                                            {goalStatus}
                                        </span>
                                    </div>

                                    <div className="continuity-goal-actions">
                                        <button
                                            type="button"
                                            className="secondary"
                                            onClick={() =>
                                                onGoalPhaseToggle(
                                                    goal.id
                                                )
                                            }
                                            aria-expanded={phasesOpen}
                                        >
                                            {phasesOpen
                                                ? 'Hide Phases'
                                                : 'Show Phases'}
                                        </button>

                                        <button
                                            type="button"
                                            className={
                                                selected
                                                    ? 'secondary'
                                                    : 'primary'
                                            }
                                            onClick={() =>
                                                onGoalSelect(
                                                    selected
                                                        ? null
                                                        : goal.id
                                                )
                                            }
                                        >
                                            {selected
                                                ? 'Active Goal'
                                                : 'Set Active'}
                                        </button>
                                    </div>
                                </div>

                                {phasesOpen && (
                                    <div className="continuity-phase-list indefinite-list">
                                        {goal.phases.map(
                                            (phase, index) => {
                                                const state =
                                                    getPhaseState(
                                                        goal.id,
                                                        index
                                                    );

                                                const neither =
                                                    !state.active &&
                                                    !state.complete;

                                                return (
                                                    <div
                                                        className={
                                                            'continuity-phase' +
                                                            (state.active
                                                                ? ' active'
                                                                : '') +
                                                            (state.complete
                                                                ? ' complete'
                                                                : '')
                                                        }
                                                        key={`${goal.id}-${index}`}
                                                    >
                                                        

                                                        <span
                                                            className={
                                                                'continuity-phase-status-indicator' +
                                                                (state.active
                                                                    ? ' active'
                                                                    : state.complete
                                                                        ? ' complete'
                                                                        : '')
                                                            }
                                                        >
                                                            {state.active
                                                                ? 'Active'
                                                                : state.complete
                                                                    ? 'Complete'
                                                                    : 'Pending'}
                                                        </span>

                                                        <div className="continuity-phase-main">
                                                            <div className="continuity-phase-title">
                                                                <span>
                                                                    Phase {index + 1}
                                                                </span>
                                                                <strong>
                                                                    {phase}
                                                                </strong>
                                                            </div>


                                                             <div className="continuity-phase-status-controls">
                                                                 <label className="continuity-phase-status-option">
                                                                     <input
                                                                         type="checkbox"
                                                                         checked={state.active}
                                                                         onChange={() =>
                                                                             onPhaseStateChange(
                                                                                 goal.id,
                                                                                 index,
                                                                                 'active'
                                                                             )
                                                                         }
                                                                     />
                                                                     <span>Active</span>
                                                                 </label>

                                                                 <label className="continuity-phase-status-option">
                                                                     <input
                                                                         type="checkbox"
                                                                         checked={state.complete}
                                                                         onChange={() =>
                                                                             onPhaseStateChange(
                                                                                 goal.id,
                                                                                 index,
                                                                                 'complete'
                                                                             )
                                                                         }
                                                                     />
                                                                     <span>Complete</span>
                                                                 </label>
                                                             </div>
                                                        </div>
                                                    </div>
                                                );
                                            }
                                        )}
                                    </div>
                                )}
                            </article>
                        );
                    })}

                    {section.phases?.map(phase => (
                        <article
                            className="continuity-phase-card"
                            key={phase.title}
                        >
                            <div className="continuity-phase-card-head">
                                <strong>{phase.title}</strong>

                                <span className="continuity-status">
                                    {phase.status}
                                </span>
                            </div>

                            <p>{phase.body}</p>
                        </article>
                    ))}

                </div>
            )}
        </section>
    );
}

function ContinuityViewer() {

    const [continuityDocument, setContinuityDocument] =
        useState('');

    const [continuityRevision, setContinuityRevision] =
        useState(null);

    const [continuitySections, setContinuitySections] =
        useState([]);

    useEffect(() => {
        let cancelled = false;

        fetch(
            `${CONTINUITY_DOCUMENT_URL}?v=${Date.now()}`,
            {
                cache: 'no-store'
            }
        )
            .then(response => {
                if (!response.ok) {
                    throw new Error(
                        `Continuity document request failed: ${response.status}`
                    );
                }

                return response.text();
            })
            .then(text => {
                if (cancelled) {
                    return;
                }

                setContinuityDocument(text);

                setContinuityRevision(
                    getContinuityRevision(text)
                );

                setContinuitySections(
                    parseContinuityDocument(text)
                );
            })
            .catch(error => {
                if (!cancelled) {
                    console.error(
                        'Unable to load continuity document:',
                        error
                    );

                    setContinuityDocument('');
                    setContinuityRevision(null);
                    setContinuitySections([]);
                }
            });

        return () => {
            cancelled = true;
        };
    }, []);

    const [openSections, setOpenSections] = useState(
        () => new Set(['goals'])
    );

    const [activeGoal, setActiveGoal] = useState(
        () =>
            localStorage.getItem(
                'webapp2-continuity-active-goal'
            ) || null
    );

    const [openGoalPhases, setOpenGoalPhases] = useState(
        () => {
            try {
                const stored = localStorage.getItem(
                    'webapp2-continuity-open-goal-phases'
                );

                if (stored) {
                    return new Set(JSON.parse(stored));
                }
            } catch {
                // Use defaults if persisted state is invalid.
            }

            return new Set(
                continuitySections
                    .find(section => section.id === 'goals')
                    ?.goals
                    ?.map(goal => goal.id) || []
            );
        }
    );

    const [phaseStatuses, setPhaseStatuses] = useState(
        () => {
            try {
                const stored = localStorage.getItem(
                    'webapp2-continuity-phase-statuses'
                );

                return stored
                    ? JSON.parse(stored)
                    : {};
            } catch {
                return {};
            }
        }
    );

    const visibleCount = useMemo(
        () => openSections.size,
        [openSections]
    );

    const toggleSection = id => {
        setOpenSections(current => {
            const next = new Set(current);

            if (next.has(id)) {
                next.delete(id);
            } else {
                next.add(id);
            }

            return next;
        });
    };

    const selectGoal = id => {
        setActiveGoal(id);

        if (id) {
            localStorage.setItem(
                'webapp2-continuity-active-goal',
                id
            );
        } else {
            localStorage.removeItem(
                'webapp2-continuity-active-goal'
            );
        }
    };

    const toggleGoalPhases = goalId => {
        setOpenGoalPhases(current => {
            const next = new Set(current);

            if (next.has(goalId)) {
                next.delete(goalId);
            } else {
                next.add(goalId);
            }

            localStorage.setItem(
                'webapp2-continuity-open-goal-phases',
                JSON.stringify([...next])
            );

            return next;
        });
    };

    const getPhaseState = (goalId, phaseIndex) => {
        const stored =
            phaseStatuses?.[goalId]?.[phaseIndex];

        return {
            active: stored?.active === true,
            complete: stored?.complete === true
        };
    };

    const setPhaseState = (
        goalId,
        phaseIndex,
        requestedState
    ) => {
        setPhaseStatuses(current => {
            const currentGoal =
                current?.[goalId] || {};

            const currentPhase =
                currentGoal?.[phaseIndex] || {
                    active: false,
                    complete: false
                };

            let nextPhase;

            if (requestedState === 'active') {
                nextPhase = {
                    active: !currentPhase.active,
                    complete: false
                };
            } else {
                nextPhase = {
                    active: false,
                    complete: !currentPhase.complete
                };
            }

            const next = {
                ...current,
                [goalId]: {
                    ...currentGoal,
                    [phaseIndex]: nextPhase
                }
            };

            localStorage.setItem(
                'webapp2-continuity-phase-statuses',
                JSON.stringify(next)
            );

            return next;
        });
    };

    const openAll = () => {
        setOpenSections(
            new Set(
                continuitySections.map(
                    section => section.id
                )
            )
        );
    };

    const closeAll = () => {
        setOpenSections(new Set());
    };

    return (
        <div className="continuity-viewer">
            <div className="continuity-toolbar">
                <div>
                    <div className="eyebrow">
                        INSTANCE MODULE
                    </div>

                    <h2>Continuity</h2>

                    <p>
                        Navigate the active WebApp-2 project
                        state without reading the raw document.
                    </p>
                </div>

                <div className="continuity-toolbar-actions">
                    <button
                        type="button"
                        className="secondary"
                        onClick={openAll}
                    >
                        Open All
                    </button>

                    <button
                        type="button"
                        className="secondary"
                        onClick={closeAll}
                    >
                        Close All
                    </button>
                </div>
            </div>

            <div className="continuity-summary">
                <div>
                    <span>OPEN SECTIONS</span>
                    <strong>{visibleCount}</strong>
                </div>

                <div>
                    <span>ACTIVE GOAL</span>
                    <strong>
                        {activeGoal
                            ? 'Selected'
                            : 'None'}
                    </strong>
                </div>

                <div>
                    <span>MODULE TYPE</span>
                    <strong>INSTANCE</strong>
                </div>
            </div>

            <div className="continuity-sections">
                {continuitySections.map(section => (
                    <Section
                        key={section.id}
                        section={section}
                        open={openSections.has(section.id)}
                        onToggle={() =>
                            toggleSection(section.id)
                        }
                        activeGoal={activeGoal}
                        onGoalSelect={selectGoal}
                        openGoalPhases={openGoalPhases}
                        onGoalPhaseToggle={
                            toggleGoalPhases
                        }
                        getPhaseState={getPhaseState}
                        onPhaseStateChange={
                            setPhaseState
                        }
                    />
                ))}
            </div>
        </div>
    );
}

export default ContinuityViewer;