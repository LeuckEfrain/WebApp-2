import { defineConfig } from 'vite'; import react from '@vitejs/plugin-react'; 
/*
 * WEBAPP2_EXTERNAL_CONTINUITY_SERVER
 *
 * The Continuity module is instance-specific.
 *
 * The authoritative continuity document remains outside the
 * WebApp-2 repository:
 *
 * D:\Projects\WebApps\continuity\webapp_2\webapp2_continuity.txt
 *
 * This Vite middleware exposes that existing file at:
 *
 * /continuity/webapp2_continuity.txt
 *
 * No duplicate runtime document is created.
 */
function webapp2ExternalContinuityServer() {
    return {
        name: 'webapp2-external-continuity-server',

        configureServer(server) {
            server.middlewares.use(
                '/continuity/webapp2_continuity.txt',
                (req, res) => {
                    const fs = require('fs');

                    const documentPath =
                        'D:\\Projects\\WebApps\\continuity\\webapp_2\\webapp2_continuity.txt';

                    try {
                        if (!fs.existsSync(documentPath)) {
                            res.statusCode = 404;
                            res.setHeader(
                                'Content-Type',
                                'text/plain; charset=utf-8'
                            );
                            res.end(
                                'Authoritative continuity document not found.'
                            );
                            return;
                        }

                        const content = fs.readFileSync(
                            documentPath,
                            'utf-8'
                        );

                        res.statusCode = 200;

                        res.setHeader(
                            'Content-Type',
                            'text/plain; charset=utf-8'
                        );

                        res.setHeader(
                            'Cache-Control',
                            'no-store, no-cache, must-revalidate'
                        );

                        res.end(content);
                    } catch (error) {
                        res.statusCode = 500;

                        res.setHeader(
                            'Content-Type',
                            'text/plain; charset=utf-8'
                        );

                        res.end(
                            `Unable to read authoritative continuity document.\n\n${error.message}`
                        );
                    }
                }
            );
        }
    };
}

export default defineConfig({plugins:[webapp2ExternalContinuityServer(), react()]});
