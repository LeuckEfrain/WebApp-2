import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';
import fs from 'node:fs';
import path from 'node:path';

const CONTINUITY_FILE = path.resolve(
    '..',
    '..',
    'continuity',
    'webapp_2',
    'webapp2_continuity.txt'
);

function webapp2ContinuityDocument() {
    return {
        name: 'webapp2-continuity-document',

        configureServer(server) {
            server.middlewares.use(
                '/__webapp2_continuity__',
                (req, res) => {
                    try {
                        if (!fs.existsSync(CONTINUITY_FILE)) {
                            res.statusCode = 404;
                            res.setHeader(
                                'Content-Type',
                                'text/plain; charset=utf-8'
                            );
                            res.end(
                                'Authoritative continuity document not found.'
                            );
                            return;
                        }

                        const content = fs.readFileSync(
                            CONTINUITY_FILE,
                            'utf8'
                        );

                        res.statusCode = 200;

                        res.setHeader(
                            'Content-Type',
                            'text/plain; charset=utf-8'
                        );

                        res.setHeader(
                            'Cache-Control',
                            'no-store'
                        );

                        res.end(content);
                    } catch (error) {
                        res.statusCode = 500;

                        res.setHeader(
                            'Content-Type',
                            'text/plain; charset=utf-8'
                        );

                        res.end(
                            `Unable to read authoritative continuity document.\n\n${error.message}`
                        );
                    }
                }
            );
        }
    };
}

export default defineConfig({
    plugins: [
        webapp2ContinuityDocument(),
        react()
    ],
    server: {
        allowedHosts: [
            '.trycloudflare.com'
        ]
    }

});